<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rosserial_hardware</name>
  <version>0.1.0</version>
  <description>
    ros2_control SystemInterface that talks the rosserial protocol directly to a
    microcontroller (Arduino, STM32...). No ROS topics are published or
    subscribed: the data goes straight into the state/command interfaces.
  </description>

  <maintainer email="rafapenya96@gmail.com">racarla96</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rosserial_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>gpio_controllers</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
