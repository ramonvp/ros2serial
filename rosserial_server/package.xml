<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rosserial_server</name>
  <version>2.0.0</version>
  <description>
    A more performance- and stability-oriented server alternative implemented
    in C++ to rosserial_python.
  </description>

  <maintainer email="ramon.viedma@hp.com">Ramon Viedma</maintainer>
  <author email="mpurvis@clearpathrobotics.com">Mike Purvis</author>

  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rosserial_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>rclcpp</depend>
  <depend>fastcdr</depend>
  <depend>ament_index_cpp</depend>
  <depend>rapidjson-dev</depend>

  <depend>introspection_interfaces</depend>

  <build_depend>libboost-thread-dev</build_depend>
  <exec_depend>libboost-thread</exec_depend>
  <!--depend>ros_helper</depend-->

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
